---
import Navbar from "../components/navbar.astro";
import Footer from "../components/footer.astro";
import "../styles/global.css";

const { title = "Job Portal" } = Astro.props;
---

<html>
  <head>
    <title>{title}</title>
  </head>

  <body class="bg-white min-h-screen">
    <!-- Wrapper biru -->
    <div class="px-4 bg-gradient-to-r from-blue-500 to-blue-400 pb-20">
      <Navbar />
      <slot name="hero" />
    </div>

    <!-- Content -->
    <main>
      <slot />
    </main>

    <Footer />
  </body>
</html>
