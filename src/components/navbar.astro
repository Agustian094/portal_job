---
import { Menu } from "lucide-astro";
---

<nav class="w-full flex justify-center pt-4">
  <div class="max-w-5xl w-full mx-auto relative">
    <!-- Navbar -->
    <div
      class="bg-white/50 rounded-xl shadow-md px-6 py-3 flex items-center justify-between"
    >
      <!-- Menu Desktop (CENTER) -->
      <ul
        class="hidden md:flex gap-8 text-gray-600 font-medium absolute left-1/2 -translate-x-1/2"
      >
        <li><a href="/home" class="hover:text-blue-500">Home</a></li>
        <li><a href="/jobs" class="hover:text-blue-500">Jobs</a></li>
        <li><a href="/company" class="hover:text-blue-500">Company</a></li>
      </ul>

      <a href="/contact" class="hover:text-blue-500">Contact</a>

      <!-- Hamburger -->
      <button
        class="md:hidden text-gray-700 z-10"
        onclick="
        const menu = document.getElementById('mobile-menu');
        menu.classList.toggle('opacity-0');
        menu.classList.toggle('scale-95');
        menu.classList.toggle('invisible');
        "
      >
        <Menu />
      </button>
    </div>

    <!-- Mobile Menu -->
    <div
      id="mobile-menu"
      class="absolute left-0 top-full mt-2 w-full bg-white rounded-xl shadow-md p-4 md:hidden z-20
         opacity-0 scale-95 invisible
         transition-all duration-300 ease-in-out"
    >
      <ul class="flex flex-col gap-4 text-gray-600 font-medium">
        <li><a href="/" class="hover:text-blue-500">Home</a></li>
        <li><a href="/jobs" class="hover:text-blue-500">Jobs</a></li>
        <li><a href="/company" class="hover:text-blue-500">Company</a></li>
        <li><a href="/contact" class="hover:text-blue-500">Contact</a></li>
      </ul>
    </div>
  </div>
</nav>
