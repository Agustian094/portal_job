---
import { Search } from "lucide-astro";

interface Props {
  showSearch?: boolean;
  title?: string;
  subtitle?: string;
}

const {
  showSearch = true,
  title = "Find Your Dream Job Today!",
  subtitle = "connecting Talent with Opportunity: Your Gateway to Career Success",
} = Astro.props as Props;
---

<section
  class="w-full flex flex-col items-center text-center pt-20 px-4 bg-gradient-to-r from-blue-500 to-blue-400"
  style={showSearch ? "padding-bottom: 2.5rem;" : "padding-bottom: 4rem;"}
>
  <!-- Title -->
  <h1 class="text-white text-4xl md:text-5xl font-bold">
    {title}
  </h1>

  <!-- Subtitle -->
  <p class="text-white/80 mt-4 max-w-xxl">
    {subtitle}
  </p>

  {showSearch && (
    <!-- Search Bar -->
    <div
      class="mt-8 w-full max-w-2xl bg-white rounded-xl shadow-lg flex items-center px-4 py-3 gap-3"
    >
      <!-- Icon -->
      <Search class="w-6 h-6 text-gray-400" />

      <!-- Input -->
      <input
        type="text"
        placeholder="Search"
        class="flex-1 outline-none text-gray-700"
      />

      <!-- Button -->
      <button
        class="bg-blue-500 text-white px-5 py-2 rounded-lg hover:bg-blue-600 transition"
      >
        Search Job
      </button>
    </div>
  )}
</section>
