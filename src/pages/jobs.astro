---
import MainLayout from "../layouts/mainlayout.astro";
import { getJobs } from "../services/jobService";
import {
  BriefcaseBusiness,
  MapPin,
  Clock3,
  ChevronLeft,
  ChevronRight,
  ClipboardList,
} from "lucide-astro";

type JobPosting = {
  _id: string;
  title?: string;
  slug?: string;
  summary?: string;
  description?: string;
  transaction_status?: number | string;
};

const response = await getJobs();

const jobs = ((response?.entries ?? []) as JobPosting[]).filter(
  (job: JobPosting) => Number(job.transaction_status) === 100,
);
---

<MainLayout title="Jobs">
  <!-- ================= HERO ================= -->
  <section
    class="bg-[#3B82F6] pt-24 pb-36 relative overflow-hidden"
  >
    <div class="w-[90%] max-w-7xl mx-auto text-center text-white">
      <h1 class="text-5xl md:text-7xl font-bold tracking-tight leading-tight">
        Join Our Tech Team
      </h1>

      <p class="mt-5 text-white/90 text-lg md:text-xl">
        Build the future of technology with innovative projects and cutting edge
        solutions
      </p>
    </div>

    <!-- Floating Badge -->
    <div
      class="absolute left-1/2 -bottom-9 -translate-x-1/2 bg-white rounded-2xl shadow-xl border border-gray-100 px-7 py-4 flex items-center gap-4"
    >
      <div
        class="w-12 h-12 rounded-xl bg-gray-100 flex items-center justify-center"
      >
        <ClipboardList class="text-gray-700" size={26} />
      </div>

      <div>
        <p class="text-gray-900 font-semibold text-2xl capitalize leading-none">
          application
        </p>
      </div>
    </div>
  </section>

  <!-- ================= JOB SECTION ================= -->
  <section class="bg-[#F5F5F5] py-28 min-h-screen">
    <div class="w-[90%] max-w-7xl mx-auto">
      <!-- Heading -->
      <div class="mb-12">
        <h2 class="text-5xl font-bold text-gray-900">
          Open Positions
        </h2>

        <p class="text-gray-500 text-xl mt-3">
          {jobs.length} jobs available
        </p>
      </div>

      <!-- ================= JOB LIST ================= -->
      <div class="space-y-8">
        {jobs.length === 0 ? (
          <div
            class="bg-white rounded-[28px] border border-gray-200 py-20 px-10 text-center shadow-sm"
          >
            <h3 class="text-3xl font-bold text-gray-900">
              No open positions yet
            </h3>

            <p class="text-gray-500 mt-4 text-lg">
              Please check back later for new opportunities.
            </p>
          </div>
        ) : (
          jobs.map((job: JobPosting) => (
            <div
              class="bg-white rounded-[28px] border border-gray-200 px-10 py-10 shadow-sm hover:shadow-lg transition-all duration-300"
            >
              <div
                class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-10"
              >
                <!-- LEFT -->
                <div class="flex-1">
                  <!-- TITLE -->
                  <h3
                    class="text-[34px] font-bold text-gray-900 leading-tight"
                  >
                    {job.title || "Untitled Job"}
                  </h3>

                  <!-- META -->
                  <div
                    class="flex flex-wrap items-center gap-7 mt-5 text-gray-500 text-base"
                  >
                    <div class="flex items-center gap-2">
                      <BriefcaseBusiness size={17} />
                      <span>Tim Teknologi Global</span>
                    </div>

                    <div class="flex items-center gap-2">
                      <MapPin size={17} />
                      <span>{job.summary || "Surabaya"}</span>
                    </div>

                    <div class="flex items-center gap-2">
                      <Clock3 size={17} />
                      <span>{job.slug || "Full-time"}</span>
                    </div>
                  </div>

                  <!-- DESCRIPTION -->
                  <p
                    class="mt-7 text-gray-600 text-xl leading-[1.9] max-w-5xl"
                  >
                    {job.description ||
                      "Join our engineering team to build scalable web applications using modern technologies and collaborate with talented developers."}
                  </p>
                </div>

                <!-- RIGHT BUTTON -->
                <div class="flex items-center lg:justify-end">
                  <a
                    href={`/jobdetail/${job._id}`}
                    class="bg-[#2563EB] hover:bg-blue-700 text-white font-semibold px-9 py-4 rounded-xl shadow-md transition-all duration-300 hover:scale-[1.03] whitespace-nowrap text-lg"
                  >
                    View Detail
                  </a>
                </div>
              </div>
            </div>
          ))
        )}
      </div>

      <!-- ================= PAGINATION ================= -->
      <div class="flex justify-center items-center gap-4 mt-20">
        <!-- Prev -->
        <button
          class="w-12 h-12 rounded-xl border border-gray-300 bg-white flex items-center justify-center text-gray-600 hover:bg-gray-100 transition"
        >
          <ChevronLeft size={18} />
        </button>

        <!-- Active -->
        <button
          class="w-12 h-12 rounded-xl bg-[#2563EB] text-white font-semibold shadow-md"
        >
          1
        </button>

        <!-- Other -->
        <button
          class="w-12 h-12 rounded-xl border border-gray-300 bg-white text-gray-700 hover:bg-gray-100 transition"
        >
          2
        </button>

        <button
          class="w-12 h-12 rounded-xl border border-gray-300 bg-white text-gray-700 hover:bg-gray-100 transition"
        >
          3
        </button>

        <!-- Next -->
        <button
          class="w-12 h-12 rounded-xl border border-gray-300 bg-white flex items-center justify-center text-gray-600 hover:bg-gray-100 transition"
        >
          <ChevronRight size={18} />
        </button>
      </div>
    </div>
  </section>
</MainLayout>